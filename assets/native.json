    {
      "id": "pdftotext",
      "name": "Poppler pdftotext",
      "description": "Fast, accurate text extraction from PDFs.",
      "priority": 6,
      "binaries": [
        "pdftotext"
      ],
      "version_args": [
        "-v"
      ],
      "install": {
        "brew": [
          "install",
          "poppler"
        ],
        "apt": [
          "install",
          "-y",
          "poppler-utils"
        ],
        "dnf": [
          "install",
          "-y",
          "poppler-utils"
        ],
        "pacman": [
          "-S",
          "--noconfirm",
          "poppler"
        ],
        "zypper": [
          "install",
          "-y",
          "poppler-tools"
        ]
      },
      "from": {
        "text": [
          "pdf"
        ]
      },
      "to": {
        "text": [
          "txt"
        ]
      }
    },
